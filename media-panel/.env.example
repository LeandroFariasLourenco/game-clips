# Credenciais IAM com permissão de listar e gravar no bucket de mídia.
# Copie para .env e preencha os valores. Este arquivo não deve receber segredos.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=game-clips-assets-306702688592-us-east-1-an
AWS_S3_PUBLIC_BASE_URL=https://game-clips-assets-306702688592-us-east-1-an.s3.us-east-1.amazonaws.com

# Chave da API SteamGridDB (sugestões de capa, banner e ícone).
STEAMGRIDDB_API_KEY=
