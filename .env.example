# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Public media bucket (game folders). Used for assets that still go straight to S3.
VITE_MEDIA_BUCKET_URL="https://game-clips-assets-306702688592-us-east-1-an.s3.us-east-1.amazonaws.com"

# Cloudflare Worker that lists games (`GET /` → `{ name, cover }[]`).
VITE_MEDIA_WORKER_URL="https://game-clips-worker.feleolive2010.workers.dev"

# AWS CLI sync (npm run deploy:media). Credentials vêm do perfil/CLI padrão da AWS.
AWS_S3_BUCKET="s3://game-clips-assets-306702688592-us-east-1-an"
AWS_REGION="us-east-1"
